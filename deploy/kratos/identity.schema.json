{
  "$id": "https://schemas.unwrap-gift.dev/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Person",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "format": "tel",
          "title": "Phone Number",
          "ory.sh/kratos": {
            "credentials": {
              "code": { "identifier": true, "via": "sms" }
            }
          }
        },
        "full_name": {
          "type": "string",
          "title": "Full Name",
          "minLength": 1
        }
      },
      "required": ["phone", "full_name"],
      "additionalProperties": false
    }
  }
}
