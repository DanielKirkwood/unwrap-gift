# Copy this to .env.production on the VPS (never commit the real file —
# it's gitignored) and fill in every value. See README.md in this directory
# for the full deploy runbook.

# The domain Caddy issues certs for and Kratos/Keto config templates
# interpolate. Three subdomains must point at this VPS: this bare domain
# (or www), api.<DOMAIN>, auth.<DOMAIN>, login.<DOMAIN>.
DOMAIN=unwrap-gift.com

# Postgres passwords — one database per service, not shared.
KRATOS_POSTGRES_PASSWORD=
KETO_POSTGRES_PASSWORD=

# Kratos secrets. Generate each with: openssl rand -hex 32
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=

# kratos-selfservice-ui-node's own session/CSRF secrets. Generate each with:
# openssl rand -hex 32
UI_COOKIE_SECRET=
UI_CSRF_COOKIE_SECRET=

# Real SMTP provider for Kratos's courier (verification/recovery emails).
# Format: smtps://user:password@host:port/
SMTP_CONNECTION_URI=

# The Kratos identity ID `db seed`/`task exec grant-admin` grants the admin
# role to. Leave empty until you've registered a user at
# https://login.<DOMAIN>/registration and have their identity ID (see
# deploy/keto/README.md's "Seeding the admin role").
KETO_SEED_ADMIN_IDENTITY_ID=

# Optional: an OTLP collector endpoint. Leave empty to run without otel.
OTEL_EXPORTER_OTLP_ENDPOINT=
