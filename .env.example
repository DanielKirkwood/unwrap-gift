# EnvVars fields (internal/config/config.go). service is always enabled;
# database/otel/kratos/keto are only enabled once their required vars below
# are set (and, for keto, once kratos is also enabled).

ENV=development
LOG_LEVEL=debug
PUBLIC_PORT=8080
PROTECTED_PORT=8081
HIDDEN_PORT=8082

# database
DATABASE_PATH=

# otel
OTEL_EXPORTER_OTLP_ENDPOINT=

# kratos (after `task kratos:up`, set to http://localhost:4433 / :4434)
KRATOS_PUBLIC_URL=
KRATOS_ADMIN_URL=
# must match deploy/kratos/kratos.yml's courier.channels[sms].request_config.auth.config.value
# (dev-courier-webhook-secret-not-secure) when running against the local dev Kratos stack.
KRATOS_COURIER_WEBHOOK_SECRET=

# keto (requires kratos to also be enabled)
KETO_READ_URL=
KETO_WRITE_URL=

# sms (seven.io) — required for real SMS sending; leave both empty to log
# instead of sending (see internal/clients/smsclient).
SEVEN_API_KEY=
SEVEN_SENDER_ID=

# keto seeding: the Kratos identity ID `db seed` grants the admin role to.
# Register a user at http://localhost:4455/registration (after `task
# auth:up`), then set this to that identity's id before running `db seed`.
KETO_SEED_ADMIN_IDENTITY_ID=

# Comma-separated feature names to force-disable, e.g. otel,kratos,keto
DISABLE_FEATURES=
